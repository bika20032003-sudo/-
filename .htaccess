# ==============================================================================
# تكوين جذر المستودع لخادم cPanel / Apache / LiteSpeed
# لحماية الموقع في حال تم رفع كامل مجلد المشروع إلى public_html على الاستضافة
# ==============================================================================

DirectoryIndex index.html index.htm public_html/index.html public_html/index.htm

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # إذا كان مجلد public_html موجوداً وتم طلب الجذر، وجّه الطلب تلقائياً إلى public_html/index.html
  RewriteCond %{REQUEST_URI} !^/public_html/
  RewriteCond %{DOCUMENT_ROOT}/public_html/index.html -f
  RewriteRule ^$ public_html/index.html [L]

  # توجيه طلبات assets إلى public_html/assets إذا طُلبت من الجذر
  RewriteCond %{REQUEST_URI} ^/assets/(.*)$
  RewriteCond %{DOCUMENT_ROOT}/public_html/assets/%1 -f
  RewriteRule ^assets/(.*)$ public_html/assets/$1 [L]
</IfModule>
