# ==============================================================================
# تكوين جذر المستودع لخادم cPanel / Apache / LiteSpeed
# لحماية الموقع في حال تم رفع كامل مجلد المشروع على الاستضافة
# ==============================================================================

DirectoryIndex index.html index.htm dist/index.html dist/index.htm

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # إذا كان مجلد dist موجوداً وتم طلب الجذر، وجّه الطلب تلقائياً إلى dist/index.html
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^$ dist/index.html [L]

  # توجيه طلبات assets إلى dist/assets إذا طُلبت من الجذر
  RewriteCond %{REQUEST_URI} ^/assets/(.*)$
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/%1 -f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
</IfModule>
